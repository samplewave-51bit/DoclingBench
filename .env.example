# LLM API Keys (Groq is recommended for LLaMA-3 models)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: IBM watsonx.ai (for IBM Granite generation)
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Dense Embedding model options:
# - all-MiniLM-L6-v2 (default)
# - BAAI/bge-small-en-v1.5
# - ibm-granite/granite-embedding-125m-english (IBM Granite)
# - ibm-granite/granite-embedding-30m-english
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
